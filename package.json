{
  "name": "grow-more",
  "version": "1.4.5",
  "description": "Grow More - A modern school management system",
  "author": "Taj & co.",
  "scripts": {
    "sync-release-notes": "node scripts/sync-release-notes.js",
    "generate-web-icons": "node scripts/generate-web-icons.js",
    "fix-icon": "node scripts/fix-icon.js",
    "start:app": "cross-env NODE_OPTIONS=--max-old-space-size=8192 craco start",
    "start:face-server": "python face_scanner_server.py",
    "start": "concurrently -k -p \"[{name}]\" -n \"APP,FACE_SERVER\" -c \"cyan,magenta\" \"npm run start:app\" \"npm run start:face-server\"",
    "build": "cross-env REACT_APP_VERSION=$npm_package_version craco build",
    "ensure-latest": "node scripts/ensure-latest-code.js",
    "ensure-latest:commit": "node scripts/ensure-latest-code.js --auto-commit",
    "build:latest": "npm run ensure-latest && npm run build",
    "build:latest:commit": "npm run ensure-latest:commit && npm run build",
    "test": "node --max-old-space-size=8192 ./node_modules/@craco/craco/bin/craco.js test",
    "eject": "react-scripts eject"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
