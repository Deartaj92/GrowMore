    "@mui/x-date-pickers": "^6.19.7",
    "@react-pdf/renderer": "^4.3.2",
    "@react-three/drei": "^9.93.0",
    "@react-three/fiber": "^8.15.12",
    "@supabase/supabase-js": "^2.49.9",
