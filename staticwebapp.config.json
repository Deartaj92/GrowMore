{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/static/*",
            "/*.{css,scss,js,png,gif,ico,jpg,svg}"
        ]
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block"
    },
    "routes": [
        {
            "route": "/static/*",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        }
    ],
    "platform": {
        "apiRuntime": "node:18"
    }
}